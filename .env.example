# SMTP credentials (Gmail: use an App Password — https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=your-app-password-here
MAIL_FROM=no-reply@example.com

# Base URL used in verification links (no trailing slash)
APP_URL=http://localhost/hot-side-dev
