# SMTP credentials (Gmail: use an App Password — https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=your-app-password-here
MAIL_FROM=no-reply@example.com

# Base URL used in verification/reset links (no trailing slash)
APP_URL=http://localhost/hot-side-dev

# Database credentials
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=hot-side

# App secrets (openssl key/iv used for password-reset links) — generate random values
APP_KEY=change-me-to-a-long-random-string
APP_IV=1234567891011121
